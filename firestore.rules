rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapOwner() {
      return signedIn() && request.auth.token.email == "gcfchen@gmail.com";
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasOrgMember(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function currentMember(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isOrgOwner(orgId) {
      return hasOrgMember(orgId)
        && currentMember(orgId).data.status == "active"
        && currentMember(orgId).data.roleLevel == 1;
    }

    function isOrganizationCreator(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.createdByUid == request.auth.uid;
    }

    function canUseStudentWorkspace(orgId) {
      return hasOrgMember(orgId)
        && currentMember(orgId).data.status == "active"
        && (
          currentMember(orgId).data.roleLevel == 1
          || currentMember(orgId).data.permissions.canViewStudents == true
        );
    }

    function canUseStudentAccounts(orgId) {
      return hasOrgMember(orgId)
        && currentMember(orgId).data.status == "active"
        && (
          currentMember(orgId).data.roleLevel == 1
          || currentMember(orgId).data.permissions.canViewStudents == true
          || currentMember(orgId).data.permissions.canRecordDailyLedger == true
        );
    }

    function canUsePayroll(orgId) {
      return hasOrgMember(orgId)
        && currentMember(orgId).data.status == "active"
        && (
          currentMember(orgId).data.roleLevel == 1
          || currentMember(orgId).data.permissions.canViewPayroll == true
        );
    }

    function canUseDailyLedger(orgId) {
      return hasOrgMember(orgId)
        && currentMember(orgId).data.status == "active"
        && (
          currentMember(orgId).data.roleLevel == 1
          || currentMember(orgId).data.permissions.canRecordDailyLedger == true
        );
    }

    function canAccessBranch(orgId, branchId) {
      return currentMember(orgId).data.roleLevel == 1
        || currentMember(orgId).data.permissions.canViewAllBranches == true
        || (
          currentMember(orgId).data.branchIds is list
          && currentMember(orgId).data.branchIds.hasAny([branchId])
        );
    }

    function canAccessAnyBranch(orgId, branchIds) {
      return currentMember(orgId).data.roleLevel == 1
        || currentMember(orgId).data.permissions.canViewAllBranches == true
        || (
          currentMember(orgId).data.branchIds is list
          && branchIds is list
          && branchIds.hasAny(currentMember(orgId).data.branchIds)
        );
    }

    function canUseBranchStudentWorkspace(orgId, branchId) {
      return canUseStudentWorkspace(orgId)
        && (
          currentMember(orgId).data.roleLevel == 1
          || currentMember(orgId).data.permissions.canViewAllBranches == true
          || (
            currentMember(orgId).data.branchIds is list
            && currentMember(orgId).data.branchIds.hasAny([branchId])
          )
        );
    }

    function isPendingSelfMember(memberId) {
      return isSelf(memberId)
        && request.resource.data.role == "pending"
        && request.resource.data.roleLevel == 4
        && request.resource.data.status == "pending";
    }

    function isBootstrapOwnerMember(memberId) {
      return isSelf(memberId)
        && isBootstrapOwner()
        && request.resource.data.role == "owner"
        && request.resource.data.roleLevel == 1
        && request.resource.data.status == "active";
    }

    function isCreatorOwnerMember(orgId, memberId) {
      return isSelf(memberId)
        && isOrganizationCreator(orgId)
        && request.resource.data.role == "owner"
        && request.resource.data.roleLevel == 1
        && request.resource.data.status == "active";
    }

    function updatesOnlyProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "displayName",
        "email",
        "photoURL",
        "updatedAt"
      ]);
    }

    match /earlyAccessLeads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly([
        "createdAt",
        "email",
        "name",
        "role",
        "source"
      ]) && request.resource.data.email is string;
      allow read, update, delete: if false;
    }

    match /users/{userId} {
      allow read, create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /organizations/{orgId} {
      allow read: if signedIn();
      allow create: if isBootstrapOwner()
        || (
          signedIn()
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.status == "active"
          && request.resource.data.name is string
        );
      allow update, delete: if isOrgOwner(orgId) || isBootstrapOwner();

      match /members/{memberId} {
        allow read: if isSelf(memberId) || hasOrgMember(orgId) || isBootstrapOwner();
        allow create: if isPendingSelfMember(memberId)
          || isBootstrapOwnerMember(memberId)
          || isCreatorOwnerMember(orgId, memberId)
          || isOrgOwner(orgId);
        allow update: if isOrgOwner(orgId)
          || isBootstrapOwner()
          || (isSelf(memberId) && updatesOnlyProfileFields());
        allow delete: if isOrgOwner(orgId) || isBootstrapOwner();
      }

      match /branches/{branchId} {
        allow read: if hasOrgMember(orgId) || isBootstrapOwner();
        allow create, update, delete: if isOrgOwner(orgId) || isBootstrapOwner();

        match /settings/{settingId} {
          allow read, write: if canUseBranchStudentWorkspace(orgId, branchId)
            || isBootstrapOwner();
        }

        match /billingWorkspaces/{workspaceId} {
          allow read, write: if canUseBranchStudentWorkspace(orgId, branchId)
            || isBootstrapOwner();

          match /classes/{classId} {
            allow read, write: if canUseBranchStudentWorkspace(orgId, branchId)
              || isBootstrapOwner();
          }
        }

        match /expenses/{expenseId} {
          allow read, create, update: if (
            canUseDailyLedger(orgId)
            && canAccessBranch(orgId, branchId)
          ) || isBootstrapOwner();
          allow delete: if isOrgOwner(orgId) || isBootstrapOwner();
        }
      }

      match /employees/{employeeId} {
        allow read: if (canUsePayroll(orgId)
          && canAccessAnyBranch(orgId, resource.data.branchIds))
          || isBootstrapOwner();
        allow create: if (canUsePayroll(orgId)
          && canAccessAnyBranch(orgId, request.resource.data.branchIds))
          || isBootstrapOwner();
        allow update: if (canUsePayroll(orgId)
          && (
            canAccessAnyBranch(orgId, resource.data.branchIds)
            || canAccessAnyBranch(orgId, request.resource.data.branchIds)
          ))
          || isBootstrapOwner();
        allow delete: if isOrgOwner(orgId) || isBootstrapOwner();

        match /salarySlips/{salarySlipId} {
          allow read: if (canUsePayroll(orgId)
            && canAccessBranch(orgId, resource.data.branchId))
            || isBootstrapOwner();
          allow create, update: if (canUsePayroll(orgId)
            && canAccessBranch(orgId, request.resource.data.branchId))
            || isBootstrapOwner();
          allow delete: if isOrgOwner(orgId) || isBootstrapOwner();
        }
      }

      match /programs/{programId} {
        allow read: if hasOrgMember(orgId) || isBootstrapOwner();
        allow create, update, delete: if isOrgOwner(orgId) || isBootstrapOwner();
      }

      match /students/{studentId} {
        allow read, create, update: if canUseStudentAccounts(orgId)
          || isBootstrapOwner();
        allow delete: if isOrgOwner(orgId) || isBootstrapOwner();

        match /invoices/{invoiceId} {
          allow read, create, update: if canUseStudentAccounts(orgId)
            || isBootstrapOwner();
          allow delete: if isOrgOwner(orgId) || isBootstrapOwner();
        }

        match /payments/{paymentId} {
          allow read, create, update: if canUseStudentAccounts(orgId)
            || isBootstrapOwner();
          allow delete: if isOrgOwner(orgId) || isBootstrapOwner();
        }
      }

      match /billingWorkspaces/{workspaceId} {
        allow read, write: if canUseStudentWorkspace(orgId) || isBootstrapOwner();

        match /classes/{classId} {
          allow read, write: if canUseStudentWorkspace(orgId) || isBootstrapOwner();
        }
      }

      match /{document=**} {
        allow read, write: if isOrgOwner(orgId) || isBootstrapOwner();
      }
    }
  }
}
